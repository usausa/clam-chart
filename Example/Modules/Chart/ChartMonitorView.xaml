<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:models="clr-namespace:Example.Models"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="Example.Modules.Chart.ChartMonitorView"
             x:DataType="{x:Type module:ChartMonitorViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartMonitorViewModel}"
             shell:ShellProperty.Title="Monitor"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function4Text="Live"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid>
        <ScrollView Style="{StaticResource BoardScroll}">
            <VerticalStackLayout Style="{StaticResource BoardStack}">
                <Grid Style="{StaticResource BoardTileGrid}"
                      ColumnDefinitions="*,*,*">
                    <clam:ClamStatView Grid.Column="0"
                                       Style="{StaticResource BoardTile}"
                                       Value="{Binding Cpu}"
                                       Fill="#5794F2" Title="CPU"
                                       TrendValues="{Binding CpuTrend}"
                                       Unit="%" ValueFormat="N1" />
                    <clam:ClamStatView Grid.Column="1"
                                       Style="{StaticResource BoardTile}"
                                       Value="{Binding Memory}"
                                       Fill="#B877D9" Title="Memory"
                                       TrendValues="{Binding MemoryTrend}"
                                       Unit="%" ValueFormat="N1" />
                    <clam:ClamStatView Grid.Column="2"
                                       Style="{StaticResource BoardTile}"
                                       Value="{Binding Temperature}"
                                       Fill="#F2495C" Title="Temp"
                                       TrendValues="{Binding TemperatureTrend}"
                                       Unit="°C" ValueFormat="N0" />
                </Grid>
                <Border Style="{StaticResource BoardPanel}">
                    <Grid Style="{StaticResource BoardPanelGrid}"
                          RowDefinitions="Auto,500">
                        <Label Grid.Row="0"
                               Style="{StaticResource BoardTitleLabel}"
                               Text="CPU load (%)" />
                        <clam:ClamChartView Grid.Row="1"
                                            Style="{StaticResource BoardChart}"
                                            HapticFeedbackEnabled="True"
                                            LegendMode="{Binding LegendMode}"
                                            LegendSortEnabled="True" LegendToggleEnabled="True" LegendValues="Last,Max,Mean"
                                            Palette="{x:Static clam:ChartPalettes.BlueShadesDark}"
                                            ValueAccessors="{x:Static models:MonitorSample.Accessors}">
                            <clam:ClamChartView.XAxis>
                                <clam:DateTimeAxis GridLineColor="{StaticResource BoardLineColor}"
                                                   WindowSize="{Binding Window}" />
                            </clam:ClamChartView.XAxis>
                            <clam:ClamChartView.YAxis>
                                <clam:NumericAxis Minimum="0" Maximum="100"
                                                  GridLineColor="{StaticResource BoardLineColor}" />
                            </clam:ClamChartView.YAxis>
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu0" ValueFormat="{}{0:N1}%" YKey="cpu0" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu1" ValueFormat="{}{0:N1}%" YKey="cpu1" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu2" ValueFormat="{}{0:N1}%" YKey="cpu2" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu3" ValueFormat="{}{0:N1}%" YKey="cpu3" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu4" ValueFormat="{}{0:N1}%" YKey="cpu4" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu5" ValueFormat="{}{0:N1}%" YKey="cpu5" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu6" ValueFormat="{}{0:N1}%" YKey="cpu6" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="cpu7" ValueFormat="{}{0:N1}%" YKey="cpu7" />
                        </clam:ClamChartView>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BoardPanel}">
                    <Grid Style="{StaticResource BoardPanelGrid}"
                          RowDefinitions="Auto,300">
                        <Label Grid.Row="0"
                               Style="{StaticResource BoardTitleLabel}"
                               Text="Temperature (°C)" />
                        <clam:ClamChartView Grid.Row="1"
                                            Style="{StaticResource BoardChart}"
                                            LegendMode="{Binding LegendMode}"
                                            LegendSortEnabled="True" LegendValues="Last"
                                            Palette="{x:Static clam:ChartPalettes.RedShadesDark}"
                                            ValueAccessors="{x:Static models:MonitorSample.Accessors}">
                            <clam:ClamChartView.XAxis>
                                <clam:DateTimeAxis GridLineColor="{StaticResource BoardLineColor}"
                                                   WindowSize="{Binding Window}" />
                            </clam:ClamChartView.XAxis>
                            <clam:ClamChartView.YAxis>
                                <clam:NumericAxis Minimum="0" Maximum="100"
                                                  GridLineColor="{StaticResource BoardLineColor}" />
                            </clam:ClamChartView.YAxis>
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="Package" ValueFormat="{}{0:N0} °C" YKey="package" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="Core 0" ValueFormat="{}{0:N0} °C" YKey="core0" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="Core 1" ValueFormat="{}{0:N0} °C" YKey="core1" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             MarkerMode="None" Title="PCH" ValueFormat="{}{0:N0} °C" YKey="pch" />
                        </clam:ClamChartView>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BoardPanel}">
                    <Grid Style="{StaticResource BoardPanelGrid}"
                          RowDefinitions="Auto,240">
                        <Label Grid.Row="0"
                               Style="{StaticResource BoardTitleLabel}"
                               Text="Network (KB/s)" />
                        <clam:ClamChartView Grid.Row="1"
                                            Style="{StaticResource BoardChart}"
                                            LegendMode="{Binding LegendMode}"
                                            LegendSortEnabled="True" LegendValues="Last,Max"
                                            Palette="{x:Static clam:ChartPalettes.PurpleShadesDark}"
                                            ValueAccessors="{x:Static models:MonitorSample.Accessors}">
                            <clam:ClamChartView.XAxis>
                                <clam:DateTimeAxis GridLineColor="{StaticResource BoardLineColor}"
                                                   WindowSize="{Binding Window}" />
                            </clam:ClamChartView.XAxis>
                            <clam:ClamChartView.YAxis>
                                <clam:NumericAxis Minimum="0"
                                                  GridLineColor="{StaticResource BoardLineColor}" />
                            </clam:ClamChartView.YAxis>
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             LiveIndicatorVisible="True" MarkerMode="None" Title="wlan0 rx" ValueFormat="{}{0:N1} KB/s"
                                             YKey="rx" />
                            <clam:LineSeries ItemsSource="{Binding Samples}"
                                             LiveIndicatorVisible="True" MarkerMode="None" Title="wlan0 tx" ValueFormat="{}{0:N1} KB/s"
                                             YKey="tx" />
                        </clam:ClamChartView>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BoardPanel}">
                    <Grid Style="{StaticResource BoardPanelGrid}"
                          RowDefinitions="Auto,220"
                          ColumnDefinitions="*,Auto">
                        <Label Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource BoardTitleLabel}"
                               Text="Run queue" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource BoardTitleLabel}"
                               Text="{Binding RunQueue, StringFormat='{0:N0}'}" />
                        <clam:ClamChartView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Style="{StaticResource BoardChart}"
                                            ValueAccessors="{x:Static models:MonitorSample.Accessors}">
                            <clam:ClamChartView.XAxis>
                                <clam:DateTimeAxis GridLineColor="{StaticResource BoardLineColor}"
                                                   WindowSize="{Binding Window}" />
                            </clam:ClamChartView.XAxis>
                            <clam:BarSeries ItemsSource="{Binding Samples}"
                                            Color="#FF9830"
                                            Title="Run queue" ValueFormat="{}{0:N0}" YKey="queue" />
                        </clam:ClamChartView>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:ChartMonitorViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="凡例" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectLegendCommand}"
                                    CommandParameter="{x:Static clam:ChartLegendMode.List}"
                                    Text="一覧">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartLegendMode.List}"
                                                 Binding="{Binding LegendMode}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectLegendCommand}"
                                    CommandParameter="{x:Static clam:ChartLegendMode.Table}"
                                    Text="表">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartLegendMode.Table}"
                                                 Binding="{Binding LegendMode}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Label Style="{StaticResource SheetTitle}"
                               Text="範囲" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*">
                            <Grid Grid.Column="0"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SheetSwitchLabel}"
                                       Text="長い範囲" />
                                <Switch Grid.Column="1"
                                        Style="{StaticResource SheetSwitch}"
                                        IsToggled="{Binding LongRange}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
