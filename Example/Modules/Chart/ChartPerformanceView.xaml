<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart"
             x:Class="Example.Modules.Chart.ChartPerformanceView"
             x:DataType="{x:Type module:ChartPerformanceViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartPerformanceViewModel}"
             shell:ShellProperty.Title="Performance"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Next"
             shell:ShellProperty.Function3Text="Again"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True">

    <Grid Style="{StaticResource ChartGrid}"
          RowDefinitions="Auto,*">
        <Label Grid.Row="0"
               Style="{StaticResource NoteLabel}"
               Text="{Binding Status}" />
        <clam:ClamChartView Grid.Row="1"
                            HeightRequest="360"
                            IsVisible="{Binding LinesVisible}"
                            FrameRendered="OnFrameRendered" VerticalOptions="Start">
            <clam:LineSeries ItemsSource="{Binding First}" />
            <clam:LineSeries ItemsSource="{Binding Second}" />
            <clam:LineSeries ItemsSource="{Binding Third}" />
        </clam:ClamChartView>
        <clam:ClamChartView Grid.Row="1"
                            HeightRequest="360"
                            IsVisible="{Binding LargeVisible}"
                            FrameRendered="OnFrameRendered" VerticalOptions="Start">
            <clam:LineSeries ItemsSource="{Binding Large}" />
        </clam:ClamChartView>
        <clam:ClamChartView Grid.Row="1"
                            HeightRequest="360"
                            IsVisible="{Binding StreamVisible}"
                            FrameRendered="OnFrameRendered" VerticalOptions="Start">
            <clam:AreaSeries ItemsSource="{Binding Stream}" />
        </clam:ClamChartView>
        <Grid Grid.Row="1"
              Style="{StaticResource StatGrid}"
              RowDefinitions="120,160,200,Auto"
              ColumnDefinitions="*,*"
              IsVisible="{Binding DashboardVisible}"
              VerticalOptions="Start">
            <clam:ClamStatView x:Name="SalesStat"
                               Grid.Row="0" Grid.Column="0"
                               Value="{Binding Sales}"
                               ContentPadding="12" DeltaCaption="前月比" FrameRendered="OnFrameRendered"
                               PreviousValue="{Binding LastSales}"
                               Title="今月の売上"
                               TrendValues="{Binding SalesTrend}"
                               Unit="円" />
            <clam:ClamStatView x:Name="ErrorStat"
                               Grid.Row="0" Grid.Column="1"
                               Value="{Binding ErrorRate}"
                               ColorMode="Indicator" FrameRendered="OnFrameRendered" IncreaseIsGood="False"
                               Thresholds="{Binding ErrorThresholds}"
                               Title="エラー率" TrendKind="Line"
                               TrendValues="{Binding ErrorTrend}"
                               Unit="%" />
            <clam:ClamRadialBarView x:Name="GoalRadial"
                                    Grid.Row="1" Grid.Column="0"
                                    ItemsSource="{Binding Goals}"
                                    FrameRendered="OnFrameRendered" OverflowMode="Wrap" />
            <clam:ClamPieChartView x:Name="ChannelPie"
                                   Grid.Row="1" Grid.Column="1"
                                   ItemsSource="{Binding Channels}"
                                   CenterLabel="合計" FrameRendered="OnFrameRendered" />
            <clam:ClamChartView x:Name="RequestChart"
                                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                FrameRendered="OnFrameRendered">
                <clam:AreaSeries ItemsSource="{Binding Requests}"
                                 MarkerMode="None" Title="リクエスト" />
            </clam:ClamChartView>
            <clam:ClamBarGaugeView x:Name="StorageGauge"
                                   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   ItemsSource="{Binding Storages}"
                                   FrameRendered="OnFrameRendered" LabelPosition="Left" ValueMode="ValueOfMaximum" />
        </Grid>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Rows}"
                        IsVisible="{Binding ListVisible}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:SparklineRow}">
                    <Grid Style="{StaticResource RowGrid}"
                          ColumnDefinitions="*,120,64">
                        <Label Grid.Column="0"
                               VerticalTextAlignment="Center"
                               Text="{Binding Name}" />
                        <clam:ClamSparklineView Grid.Column="1"
                                                HeightRequest="28"
                                                FrameRendered="OnFrameRendered"
                                                Markers="{Binding Markers}"
                                                Values="{Binding Values}" />
                        <Label Grid.Column="2"
                               HorizontalTextAlignment="End" VerticalTextAlignment="Center"
                               Text="{Binding Last, StringFormat='{0:N1}'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentView>
