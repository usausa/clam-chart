<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="Example.Modules.Chart.ChartLiveView"
             x:DataType="{x:Type module:ChartLiveViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartLiveViewModel}"
             shell:ShellProperty.Title="Live"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function4Text="Live"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid>
        <ScrollView>
            <Grid Style="{StaticResource StatGrid}"
                  RowDefinitions="96,96,96,Auto">
                <Border Grid.Row="0"
                        Style="{StaticResource StatBorder}">
                    <clam:ClamStatView Value="{Binding Cpu}"
                                       AlertAnimationEnabled="True" ColorMode="Background" FillMode="Gradient"
                                       Thresholds="{Binding CpuThresholds}"
                                       Title="CPU" TrendPlacement="Background"
                                       TrendValues="{Binding CpuTrend}"
                                       Unit="%" ValueFormat="N1" />
                </Border>
                <Border Grid.Row="1"
                        Style="{StaticResource StatBorder}">
                    <clam:ClamStatView Value="{Binding Memory}"
                                       ColorMode="Background"
                                       Fill="{AppThemeBinding Light=#3274D9,
                                                              Dark=#5794F2}"
                                       FillMode="Gradient" Title="メモリ" TrendPlacement="Background"
                                       TrendValues="{Binding MemoryTrend}"
                                       Unit="MB" ValueFormat="N0" />
                </Border>
                <Border Grid.Row="2"
                        Style="{StaticResource StatBorder}">
                    <clam:ClamStatView Value="{Binding Connections}"
                                       ColorMode="Background"
                                       Fill="{AppThemeBinding Light=#A352CC,
                                                              Dark=#B877D9}"
                                       FillMode="Gradient" Title="接続数" TrendPlacement="Background"
                                       TrendValues="{Binding ConnectionTrend}"
                                       ValueFormat="N0" />
                </Border>
                <Border Grid.Row="3"
                        Style="{StaticResource StatBorder}">
                    <Grid Style="{StaticResource PanelGrid}"
                          RowDefinitions="Auto,240">
                        <Label Grid.Row="0"
                               Style="{StaticResource PanelTitleLabel}"
                               Text="リクエスト (件/秒)" />
                        <clam:ClamChartView Grid.Row="1"
                                            ContentPadding="0" TrackballMode="LongPress">
                            <clam:ClamChartView.XAxis>
                                <clam:DateTimeAxis WindowSize="{Binding Window}" />
                            </clam:ClamChartView.XAxis>
                            <clam:ClamChartView.YAxis>
                                <clam:NumericAxis Minimum="0" />
                            </clam:ClamChartView.YAxis>
                            <clam:AreaSeries ItemsSource="{Binding Requests}"
                                             LiveIndicatorVisible="True" MarkerMode="None" Title="リクエスト" ValueFormat="{}{0:N1} 件/秒" />
                        </clam:ClamChartView>
                    </Grid>
                </Border>
            </Grid>
        </ScrollView>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:ChartLiveViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="動き" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*">
                            <Grid Grid.Column="0"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SheetSwitchLabel}"
                                       Text="速い" />
                                <Switch Grid.Column="1"
                                        Style="{StaticResource SheetSwitch}"
                                        IsToggled="{Binding FastSpeed}" />
                            </Grid>
                            <Grid Grid.Column="1"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SheetSwitchLabel}"
                                       Text="長い範囲" />
                                <Switch Grid.Column="1"
                                        Style="{StaticResource SheetSwitch}"
                                        IsToggled="{Binding LongRange}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
