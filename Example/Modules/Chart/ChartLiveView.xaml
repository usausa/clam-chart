<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart"
             x:Class="Example.Modules.Chart.ChartLiveView"
             x:DataType="{x:Type module:ChartLiveViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartLiveViewModel}"
             shell:ShellProperty.Title="Live"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Speed"
             shell:ShellProperty.Function3Text="Window"
             shell:ShellProperty.Function4Text="Live"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <ScrollView>
        <Grid Style="{StaticResource StatGrid}"
              RowDefinitions="96,96,96,Auto">
            <Border Grid.Row="0"
                    Style="{StaticResource StatBorder}">
                <clam:ClamStatView Value="{Binding Cpu}"
                                   AlertAnimationEnabled="True" ColorMode="BackgroundGradient"
                                   Thresholds="{Binding CpuThresholds}"
                                   Title="CPU" TrendPlacement="Background"
                                   TrendValues="{Binding CpuTrend}"
                                   Unit="%" ValueFormat="N1" />
            </Border>
            <Border Grid.Row="1"
                    Style="{StaticResource StatBorder}">
                <clam:ClamStatView Value="{Binding Memory}"
                                   ColorMode="BackgroundGradient"
                                   Fill="{AppThemeBinding Light=#3274D9,
                                                          Dark=#5794F2}"
                                   Title="メモリ" TrendPlacement="Background"
                                   TrendValues="{Binding MemoryTrend}"
                                   Unit="MB" ValueFormat="N0" />
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource StatBorder}">
                <clam:ClamStatView Value="{Binding Connections}"
                                   ColorMode="BackgroundGradient"
                                   Fill="{AppThemeBinding Light=#A352CC,
                                                          Dark=#B877D9}"
                                   Title="接続数" TrendPlacement="Background"
                                   TrendValues="{Binding ConnectionTrend}"
                                   ValueFormat="N0" />
            </Border>
            <Border Grid.Row="3"
                    Style="{StaticResource StatBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,240">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="リクエスト (件/秒)" />
                    <clam:ClamChartView Grid.Row="1"
                                        ContentPadding="0" TrackballMode="LongPress">
                        <clam:ClamChartView.XAxis>
                            <clam:DateTimeAxis WindowSize="{Binding Window}" />
                        </clam:ClamChartView.XAxis>
                        <clam:ClamChartView.YAxis>
                            <clam:NumericAxis Minimum="0" />
                        </clam:ClamChartView.YAxis>
                        <clam:AreaSeries ItemsSource="{Binding Requests}"
                                         LiveIndicatorVisible="True" MarkerMode="None" Title="リクエスト" ValueFormat="{}{0:N1} 件/秒" />
                    </clam:ClamChartView>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>

</ContentView>
