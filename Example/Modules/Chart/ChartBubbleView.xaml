<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:models="clr-namespace:Example.Models"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart"
             x:Class="Example.Modules.Chart.ChartBubbleView"
             x:DataType="{x:Type module:ChartBubbleViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartBubbleViewModel}"
             shell:ShellProperty.Title="Bubble"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Shape"
             shell:ShellProperty.Function3Text="Size"
             shell:ShellProperty.Function4Text="Data"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource ChartGrid}">
        <clam:ClamChartView SelectionMode="Item" TrackballMode="Touch"
                            ValueAccessors="{x:Static models:StoreSample.Accessors}"
                            XKey="sales">
            <clam:ClamChartView.XAxis>
                <clam:NumericAxis Title="売上 (万円)" />
            </clam:ClamChartView.XAxis>
            <clam:ClamChartView.YAxis>
                <clam:NumericAxis Title="利益率 (%)" TitleOrientation="Vertical" />
            </clam:ClamChartView.YAxis>
            <clam:BubbleSeries ItemsSource="{Binding City}"
                               MarkerShape="{Binding MarkerShape}"
                               MaxBubbleSize="{Binding MaxBubbleSize}"
                               SizeIncludesZero="{Binding SizeIncludesZero}"
                               SizeKey="visitors" Title="都市部" YKey="margin" />
            <clam:BubbleSeries ItemsSource="{Binding Suburb}"
                               MarkerShape="{Binding MarkerShape}"
                               MaxBubbleSize="{Binding MaxBubbleSize}"
                               SizeIncludesZero="{Binding SizeIncludesZero}"
                               SizeKey="visitors" Title="郊外" YKey="margin" />
        </clam:ClamChartView>
    </Grid>

</ContentView>
