<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:models="clr-namespace:Example.Models"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="Example.Modules.Chart.ChartStateTimelineView"
             x:DataType="{x:Type module:ChartStateTimelineViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartStateTimelineViewModel}"
             shell:ShellProperty.Title="State timeline"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function4Text="Data"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid>
        <Grid Style="{StaticResource StatGrid}"
              RowDefinitions="*,*">
            <Border Grid.Row="0"
                    Style="{StaticResource StatBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="サーバーの状態" />
                    <clam:ClamStateTimelineView Grid.Row="1"
                                                ItemsSource="{Binding States}"
                                                Maximum="{Binding Now}"
                                                AlignValue="{Binding AlignValue}"
                                                ContentPadding="0"
                                                MergeValues="{Binding MergeValues}"
                                                RowKey="server" StartKey="start" StateKey="state" TrackballMode="Touch"
                                                ValueAccessors="{x:Static models:ServerState.Accessors}">
                        <clam:ClamStateTimelineView.ValueMappings>
                            <clam:ChartValueMapping Value="Running"
                                                    Text="稼働"
                                                    Level="Good" />
                            <clam:ChartValueMapping Value="Degraded"
                                                    Text="低下"
                                                    Level="Warning" />
                            <clam:ChartValueMapping Value="Stopped"
                                                    Text="停止"
                                                    Level="Critical" />
                        </clam:ClamStateTimelineView.ValueMappings>
                    </clam:ClamStateTimelineView>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Style="{StaticResource StatBorder}">
                <Grid Style="{StaticResource PanelGrid}"
                      RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="CPU 使用率の段階" />
                    <clam:ClamStateTimelineView Grid.Row="1"
                                                ItemsSource="{Binding Levels}"
                                                Maximum="{Binding Now}"
                                                AlignValue="{Binding AlignValue}"
                                                ContentPadding="0"
                                                MergeValues="{Binding MergeValues}"
                                                RowKey="host" StartKey="time" StateKey="level" TrackballMode="Touch"
                                                ValueAccessors="{x:Static models:CpuLevel.Accessors}">
                        <clam:ClamStateTimelineView.Thresholds>
                            <clam:ChartThreshold Level="Good" />
                            <clam:ChartThreshold Value="60"
                                                 Level="Warning" />
                            <clam:ChartThreshold Value="85"
                                                 Level="Critical" />
                        </clam:ClamStateTimelineView.Thresholds>
                    </clam:ClamStateTimelineView>
                </Grid>
            </Border>
        </Grid>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:ChartStateTimelineViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="値の寄せ" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="{x:Static clam:ChartValueAlignment.Left}"
                                    Text="左">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartValueAlignment.Left}"
                                                 Binding="{Binding AlignValue}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="{x:Static clam:ChartValueAlignment.Center}"
                                    Text="中央">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartValueAlignment.Center}"
                                                 Binding="{Binding AlignValue}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectAlignCommand}"
                                    CommandParameter="{x:Static clam:ChartValueAlignment.Right}"
                                    Text="右">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartValueAlignment.Right}"
                                                 Binding="{Binding AlignValue}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Label Style="{StaticResource SheetTitle}"
                               Text="表示" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*">
                            <Grid Grid.Column="0"
                                  ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SheetSwitchLabel}"
                                       Text="同じ値をまとめる" />
                                <Switch Grid.Column="1"
                                        Style="{StaticResource SheetSwitch}"
                                        IsToggled="{Binding MergeValues}" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
