<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:models="clr-namespace:Example.Models"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart"
             x:Class="Example.Modules.Chart.ChartHeatmapView"
             x:DataType="{x:Type module:ChartHeatmapViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartHeatmapViewModel}"
             shell:ShellProperty.Title="Heatmap"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Legend"
             shell:ShellProperty.Function3Text="Colors"
             shell:ShellProperty.Function4Text="Data"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True"
             shell:ShellProperty.Function3Enabled="True"
             shell:ShellProperty.Function4Enabled="True">

    <Grid Style="{StaticResource StatGrid}"
          RowDefinitions="*,*">
        <Border Grid.Row="0"
                Style="{StaticResource StatBorder}">
            <Grid Style="{StaticResource PanelGrid}"
                  RowDefinitions="Auto,*">
                <Label Grid.Row="0"
                       Style="{StaticResource PanelTitleLabel}"
                       Text="曜日と時間帯のアクセス数" />
                <clam:ClamHeatmapView Grid.Row="1"
                                      ItemsSource="{Binding Accesses}"
                                      ColorScale="{Binding ColorScale}"
                                      ColumnKey="hour" ContentPadding="0"
                                      LegendPosition="{Binding LegendPosition}"
                                      RowKey="day" SelectionMode="Item" TrackballMode="Touch"
                                      ValueAccessors="{x:Static models:AccessCount.Accessors}"
                                      ValueKey="count" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Style="{StaticResource StatBorder}">
            <Grid Style="{StaticResource PanelGrid}"
                  RowDefinitions="Auto,*">
                <Label Grid.Row="0"
                       Style="{StaticResource PanelTitleLabel}"
                       Text="日ごとの活動量" />
                <clam:ClamHeatmapView Grid.Row="1"
                                      ItemsSource="{Binding Activities}"
                                      ColorScale="{Binding ColorScale}"
                                      ContentPadding="0" LayoutMode="Calendar"
                                      LegendPosition="{Binding LegendPosition}"
                                      SelectionMode="Item" TrackballMode="Touch" />
            </Grid>
        </Border>
    </Grid>

</ContentView>
