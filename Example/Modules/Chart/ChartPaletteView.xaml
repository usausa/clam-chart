<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:models="clr-namespace:Example.Models"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="Example.Modules.Chart.ChartPaletteView"
             x:DataType="{x:Type module:ChartPaletteViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartPaletteViewModel}"
             shell:ShellProperty.Title="Palette"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource ChartStack}">
                <Border Style="{StaticResource StatBorder}">
                    <VerticalStackLayout Style="{StaticResource PanelStack}">
                        <Label Style="{StaticResource PanelTitleLabel}"
                               Text="テーマの既定" />
                        <clam:ClamChartView HeightRequest="240"
                                            FillMode="{Binding FillMode}"
                                            ValueAccessors="{x:Static models:ServiceLoad.Accessors}"
                                            XKey="label">
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="web" YKey="web" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="api" YKey="api" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="db" YKey="db" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="batch" YKey="batch" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="cache" YKey="cache" />
                        </clam:ClamChartView>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource StatBorder}">
                    <VerticalStackLayout Style="{StaticResource PanelStack}">
                        <Label Style="{StaticResource PanelTitleLabel}"
                               Text="ライブラリの Grafana" />
                        <clam:ClamChartView HeightRequest="240"
                                            Palette="{AppThemeBinding Light={x:Static clam:ChartPalettes.GrafanaLight},
                                                                      Dark={x:Static clam:ChartPalettes.GrafanaDark}}"
                                            ValueAccessors="{x:Static models:ServiceLoad.Accessors}"
                                            XKey="label">
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="web" YKey="web" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="api" YKey="api" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="db" YKey="db" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="batch" YKey="batch" />
                            <clam:BarSeries ItemsSource="{Binding Quarters}"
                                            Title="cache" YKey="cache" />
                        </clam:ClamChartView>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource StatBorder}">
                    <VerticalStackLayout Style="{StaticResource PanelStack}">
                        <Label Style="{StaticResource PanelTitleLabel}"
                               Text="ライブラリのマテリアル" />
                        <clam:ClamChartView HeightRequest="240"
                                            Palette="{AppThemeBinding Light={x:Static clam:ChartPalettes.MaterialLight},
                                                                      Dark={x:Static clam:ChartPalettes.MaterialDark}}"
                                            ValueAccessors="{x:Static models:ServiceLoad.Accessors}"
                                            XKey="label">
                            <clam:LineSeries ItemsSource="{Binding Months}"
                                             Title="web" YKey="web" />
                            <clam:LineSeries ItemsSource="{Binding Months}"
                                             Title="api" YKey="api" />
                            <clam:LineSeries ItemsSource="{Binding Months}"
                                             Title="db" YKey="db" />
                            <clam:LineSeries ItemsSource="{Binding Months}"
                                             Title="batch" YKey="batch" />
                            <clam:LineSeries ItemsSource="{Binding Months}"
                                             Title="cache" YKey="cache" />
                        </clam:ClamChartView>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource StatBorder}">
                    <VerticalStackLayout Style="{StaticResource PanelStack}">
                        <Label Style="{StaticResource PanelTitleLabel}"
                               Text="アプリのマテリアル(400)" />
                        <clam:ClamPieChartView HeightRequest="240"
                                               ItemsSource="{Binding Shares}"
                                               Palette="{x:Static models:AppPalettes.Material}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:ChartPaletteViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="塗り" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectFillModeCommand}"
                                    CommandParameter="{x:Static clam:ChartFillMode.Solid}"
                                    Text="単色">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartFillMode.Solid}"
                                                 Binding="{Binding FillMode}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectFillModeCommand}"
                                    CommandParameter="{x:Static clam:ChartFillMode.Gradient}"
                                    Text="グラデーション">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="{x:Static clam:ChartFillMode.Gradient}"
                                                 Binding="{Binding FillMode}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
