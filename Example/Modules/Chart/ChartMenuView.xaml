<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:modules="clr-namespace:Example.Modules"
             x:Class="Example.Modules.Chart.ChartMenuView"
             x:DataType="{x:Type module:ChartMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartMenuViewModel}"
             shell:ShellProperty.Title="ClamChart"
             shell:ShellProperty.Function1Text="Exit"
             shell:ShellProperty.Function2Text="Theme"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*">
        <Button Grid.Row="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartLine}"
                Text="1.Line" />
        <Button Grid.Row="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartBar}"
                Text="2.Bar" />
        <Button Grid.Row="2"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartTimeSeries}"
                Text="3.Time series" />
        <Button Grid.Row="3"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartDualAxis}"
                Text="4.Dual axis" />
        <Button Grid.Row="4"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartPie}"
                Text="5.Pie" />
        <Button Grid.Row="5"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartSparkline}"
                Text="6.Sparkline" />
        <Button Grid.Row="6"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartDensity}"
                Text="7.Density" />
        <Button Grid.Row="7"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartPerformance}"
                Text="8.Performance" />
    </Grid>

</ContentView>
