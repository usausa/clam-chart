<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:modules="clr-namespace:Example.Modules"
             x:Class="Example.Modules.Chart.ChartMenuView"
             x:DataType="{x:Type module:ChartMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartMenuViewModel}"
             shell:ShellProperty.Title="ClamChart"
             shell:ShellProperty.Function1Text="Exit"
             shell:ShellProperty.Function2Text="Theme"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*"
          ColumnDefinitions="*,*">
        <Button Grid.Row="0" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartLine}"
                Text="1.Line" />
        <Button Grid.Row="0" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartBar}"
                Text="2.Bar" />
        <Button Grid.Row="1" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartPie}"
                Text="3.Pie" />
        <Button Grid.Row="1" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartSparkline}"
                Text="4.Sparkline" />
        <Button Grid.Row="2" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartStat}"
                Text="5.Stat" />
        <Button Grid.Row="2" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartBarGauge}"
                Text="6.Bar gauge" />
        <Button Grid.Row="3" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartRadialBar}"
                Text="7.Radial bar" />
        <Button Grid.Row="3" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartScatter}"
                Text="8.Scatter" />
        <Button Grid.Row="4" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartRangeBar}"
                Text="9.Range bar" />
        <Button Grid.Row="4" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartBubble}"
                Text="10.Bubble" />
        <Button Grid.Row="5" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartRadar}"
                Text="11.Radar" />
        <Button Grid.Row="5" Grid.Column="1"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartHeatmap}"
                Text="12.Heatmap" />
        <Button Grid.Row="6" Grid.Column="0"
                Style="{StaticResource MenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartStateTimeline}"
                Text="13.State timeline" />
        <Button Grid.Row="7" Grid.Column="0"
                Style="{StaticResource FeatureMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartTimeSeries}"
                Text="14.Time series" />
        <Button Grid.Row="7" Grid.Column="1"
                Style="{StaticResource FeatureMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartDualAxis}"
                Text="15.Dual axis" />
        <Button Grid.Row="8" Grid.Column="0"
                Style="{StaticResource FeatureMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartThreshold}"
                Text="16.Thresholds" />
        <Button Grid.Row="8" Grid.Column="1"
                Style="{StaticResource FeatureMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartPalette}"
                Text="17.Palette" />
        <Button Grid.Row="9" Grid.Column="0"
                Style="{StaticResource FeatureMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartOverlay}"
                Text="18.Overlay" />
        <Button Grid.Row="9" Grid.Column="1"
                Style="{StaticResource FeatureMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartDrawing}"
                Text="19.Drawing" />
        <Button Grid.Row="10" Grid.Column="0"
                Style="{StaticResource DashboardMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartMonitor}"
                Text="20.Monitor" />
        <Button Grid.Row="10" Grid.Column="1"
                Style="{StaticResource DashboardMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartLive}"
                Text="21.Live" />
        <Button Grid.Row="11" Grid.Column="0"
                Style="{StaticResource DashboardMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartDashboard}"
                Text="22.Dashboard" />
        <Button Grid.Row="12" Grid.Column="0"
                Style="{StaticResource ToolMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartDensity}"
                Text="23.Density" />
        <Button Grid.Row="12" Grid.Column="1"
                Style="{StaticResource ToolMenuButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{x:Static modules:ViewId.ChartPerformance}"
                Text="24.Performance" />
    </Grid>

</ContentView>
