<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Example.Shell"
             xmlns:models="clr-namespace:Example.Models"
             xmlns:module="clr-namespace:Example.Modules.Chart"
             xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls"
             x:Class="Example.Modules.Chart.ChartDensityView"
             x:DataType="{x:Type module:ChartDensityViewModel}"
             s:BindingContextResolver.Type="{x:Type module:ChartDensityViewModel}"
             shell:ShellProperty.Title="Density"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function2Text="Setting"
             shell:ShellProperty.Function1Enabled="True"
             shell:ShellProperty.Function2Enabled="True">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource ChartStack}">
                <Border Style="{StaticResource TapBorder}"
                        HorizontalOptions="Start">
                    <clam:ClamChartView WidthRequest="{Binding ChartWidth}"
                                        HeightRequest="{Binding ChartHeight}"
                                        ValueAccessors="{x:Static models:MonthlySales.Accessors}"
                                        XKey="month">
                        <clam:BarSeries ItemsSource="{Binding Sales}"
                                        Title="Store" YKey="store" />
                        <clam:LineSeries ItemsSource="{Binding Sales}"
                                         Title="Target" YKey="target" />
                    </clam:ClamChartView>
                </Border>
                <Border Style="{StaticResource TapBorder}"
                        HorizontalOptions="Start">
                    <clam:ClamPieChartView WidthRequest="{Binding ChartWidth}"
                                           HeightRequest="{Binding ChartHeight}"
                                           ItemsSource="{Binding Expenses}"
                                           CenterLabel="Total" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <cmc:BottomSheetView Style="{StaticResource SettingSheet}"
                             IsOpen="{Binding IsSettingOpen}">
            <cmc:BottomSheetView.SheetTemplate>
                <DataTemplate x:DataType="{x:Type module:ChartDensityViewModel}">
                    <VerticalStackLayout Style="{StaticResource SheetStack}">
                        <Label Style="{StaticResource SheetTitle}"
                               Text="大きさ" />
                        <Grid Style="{StaticResource SheetGrid}"
                              ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectSizeCommand}"
                                    CommandParameter="0"
                                    Text="小">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="0"
                                                 Binding="{Binding SizeIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectSizeCommand}"
                                    CommandParameter="1"
                                    Text="中">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="1"
                                                 Binding="{Binding SizeIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SheetButton}"
                                    Command="{Binding SelectSizeCommand}"
                                    CommandParameter="2"
                                    Text="大">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Value="2"
                                                 Binding="{Binding SizeIndex}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </cmc:BottomSheetView.SheetTemplate>
        </cmc:BottomSheetView>
    </Grid>

</ContentView>
