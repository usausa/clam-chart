<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:clam="clr-namespace:ClamChart;assembly=ClamChart" xmlns:cmc="clr-namespace:MauiComponents.Controls;assembly=MauiComponents.Controls">

    <!-- ================================================================================ -->
    <!-- Value -->
    <!-- ================================================================================ -->

    <Color x:Key="PrimaryTextColor">#DE000000</Color>
    <Color x:Key="SecondaryTextColor">#99000000</Color>
    <Color x:Key="DisabledColor">#61000000</Color>
    <Color x:Key="DarkPrimaryTextColor">#DEFFFFFF</Color>
    <Color x:Key="DarkSecondaryTextColor">#B3FFFFFF</Color>
    <Color x:Key="DarkBackgroundColor">#1F1F1D</Color>
    <Color x:Key="DarkDividerColor">#383835</Color>
    <Color x:Key="DividerColor">#E1E0D9</Color>

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource DarkBackgroundColor}}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken4}" />
    </Style>

    <Style x:Key="HeaderTitleLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Function -->
    <!-- ================================================================================ -->

    <Style x:Key="FunctionGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="1" />
    </Style>

    <Style x:Key="FunctionButtonBase"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="FunctionButton1"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RedAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RedAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton2"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource IndigoAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource IndigoAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource IndigoAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton3"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FunctionButton4"
           TargetType="Button"
           BasedOn="{StaticResource FunctionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeAccent4}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeAccent3}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Sub Menu -->
    <!-- ================================================================================ -->

    <Style x:Key="SubMenuGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="1" />
    </Style>

    <Style x:Key="SubMenuButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CyanDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CyanDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Sub menu button that shows an on state -->
    <Style x:Key="ToggleButton"
           TargetType="Button"
           BasedOn="{StaticResource SubMenuButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource GrayDefault}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Layout -->
    <!-- ================================================================================ -->

    <Style x:Key="MenuGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="RowSpacing" Value="6" />
        <Setter Property="ColumnSpacing" Value="6" />
    </Style>

    <Style x:Key="FillGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Button -->
    <!-- ================================================================================ -->

    <Style x:Key="MenuButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BlueDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FeatureMenuButton"
           TargetType="Button"
           BasedOn="{StaticResource MenuButton}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource TealDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource TealDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="DashboardMenuButton"
           TargetType="Button"
           BasedOn="{StaticResource MenuButton}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DeepPurpleDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DeepPurpleDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ToolMenuButton"
           TargetType="Button"
           BasedOn="{StaticResource MenuButton}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource OrangeDarken2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Label -->
    <!-- ================================================================================ -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource DarkSecondaryTextColor}}" />
    </Style>

    <Style x:Key="TitleLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource DarkPrimaryTextColor}}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ValueLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource DarkPrimaryTextColor}}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="NoteLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Chart -->
    <!-- ================================================================================ -->

    <Style TargetType="clam:ChartViewBase"
           BasedOn="{StaticResource ClamChartTheme}"
           ApplyToDerivedTypes="True" />

    <Style TargetType="clam:ClamSparklineView"
           BasedOn="{StaticResource ClamChartSparklineTheme}" />

    <Style TargetType="clam:ClamHeatmapView"
           BasedOn="{StaticResource ClamChartHeatmapTheme}" />

    <Style TargetType="clam:ClamStatView"
           BasedOn="{StaticResource ClamChartStatTheme}" />

    <Style TargetType="clam:ClamRadarChartView"
           BasedOn="{StaticResource ClamChartRadarTheme}" />

    <Style TargetType="clam:ClamStateTimelineView"
           BasedOn="{StaticResource ClamChartStateTimelineTheme}" />

    <Style TargetType="clam:ClamRadialBarView"
           BasedOn="{StaticResource ClamChartRadialBarTheme}" />

    <Style x:Key="OverlayChart"
           TargetType="clam:ClamSparklineView"
           BasedOn="{StaticResource ClamChartOverlayTheme}" />

    <Style x:Key="OverlayDarkChart"
           TargetType="clam:ClamChartView"
           BasedOn="{StaticResource ClamChartOverlayTheme}">
        <Setter Property="PrimaryTextColor" Value="#F0EFEC" />
        <Setter Property="SecondaryTextColor" Value="#C3C2B7" />
        <Setter Property="MutedTextColor" Value="#898781" />
        <Setter Property="TextHaloColor" Value="#CC000000" />
        <Setter Property="Palette" Value="{x:Static clam:ChartPalettes.DefaultDark}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Board -->
    <!-- ================================================================================ -->

    <Color x:Key="BoardBackColor">#111318</Color>
    <Color x:Key="BoardPanelColor">#181B22</Color>
    <Color x:Key="BoardLineColor">#2A2F3A</Color>
    <Color x:Key="BoardTitleColor">#9AA4B2</Color>

    <Style x:Key="BoardScroll"
           TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{StaticResource BoardBackColor}" />
    </Style>

    <Style x:Key="BoardStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="BoardTileGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="4" />
    </Style>

    <Style x:Key="BoardPanel"
           TargetType="Border">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="BackgroundColor" Value="{StaticResource BoardPanelColor}" />
        <Setter Property="Stroke" Value="{StaticResource BoardLineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="BoardPanelGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="2" />
    </Style>

    <Style x:Key="BoardTitleLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource BoardTitleColor}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="BoardTile"
           TargetType="clam:ClamStatView"
           BasedOn="{StaticResource ClamChartStatTheme}">
        <Setter Property="HeightRequest" Value="86" />
        <Setter Property="ColorMode" Value="Background" />
        <Setter Property="ContentPadding" Value="6" />
        <Setter Property="FillMode" Value="Gradient" />
        <Setter Property="GradientStrength" Value="1" />
        <Setter Property="LayoutMode" Value="Horizontal" />
        <Setter Property="TrendPlacement" Value="Background" />
        <Setter Property="ValueFontSize" Value="20" />
    </Style>

    <Style x:Key="BoardChart"
           TargetType="clam:ClamChartView"
           BasedOn="{StaticResource ClamChartTheme}">
        <Setter Property="ContentPadding" Value="0" />
        <Setter Property="PrimaryTextColor" Value="#F0EFEC" />
        <Setter Property="SecondaryTextColor" Value="#C3C2B7" />
        <Setter Property="TooltipBackground" Value="#F01F1F1D" />
        <Setter Property="TooltipTextColor" Value="#F0EFEC" />
        <Setter Property="TooltipBorderColor" Value="#1AF0EFEC" />
        <Setter Property="TrackColor" Value="#12FFFFFF" />
        <Setter Property="TrackballMode" Value="LongPress" />
        <Setter Property="TrackballSnapEnabled" Value="False" />
        <Setter Property="TrackingGroup" Value="monitor" />
        <Setter Property="TrackingGroupMode" Value="Tooltip" />
        <Setter Property="XKey" Value="time" />
    </Style>

    <Style x:Key="ChartStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="ChartGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="8" />
        <Setter Property="RowSpacing" Value="8" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="RowGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="TableRowGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="TableHeaderLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource DarkPrimaryTextColor}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="StatGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="8" />
        <Setter Property="RowSpacing" Value="8" />
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="StatBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DarkDividerColor}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="PanelStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="PanelGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="12" />
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <Style x:Key="PanelTitleLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource DarkPrimaryTextColor}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TapBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="4" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DarkDividerColor}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <!-- ================================================================================ -->
    <!-- Setting sheet -->
    <!-- ================================================================================ -->

    <Style x:Key="SettingSheet"
           TargetType="cmc:BottomSheetView">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HalfExpandedRatio" Value="0.45" />
        <Setter Property="SheetBackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource DarkBackgroundColor}}" />
    </Style>

    <Style x:Key="SheetStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12,0,12,12" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="SheetTitle"
           TargetType="Label">
        <Setter Property="Padding" Value="2,6,2,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource DarkSecondaryTextColor}}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="SheetGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="6" />
        <Setter Property="RowSpacing" Value="4" />
    </Style>

    <Style x:Key="SheetSwitchLabel"
           TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource DarkPrimaryTextColor}}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SheetSwitch"
           TargetType="Switch">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Scale" Value="0.75" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="OnColor" Value="{StaticResource BlueDefault}" />
    </Style>

    <Style x:Key="SheetButton"
           TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource GrayLighten1}, Dark={StaticResource DarkDividerColor}}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource DarkPrimaryTextColor}}" />
    </Style>

</ResourceDictionary>
